rules_version = '2';

// Deny every client read and write. The API and worker use the Admin SDK (service account), which bypasses these
// rules. Browsers never talk to Firestore directly. Do not loosen this file; add an API endpoint instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
